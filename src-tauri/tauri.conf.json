{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "estudio-arkipelago",
  "version": "0.1.0",
  "identifier": "com.arkipelago.studio",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ESTUDIO ARKIPELAGO",
        "width": 1366,
        "height": 868,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "WebView2Loader.dll": "./"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
